PORT=3000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=execution_service
MONGODB_TASKS_COLLECTION=execution_tasks
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_READINESS_ENABLED=false
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=execution.events
RABBITMQ_EXECUTION_COMMAND_QUEUE=execution.commands
RABBITMQ_EXECUTION_STATUS_ROUTING_KEY=execution.task.status.changed
RABBITMQ_CONSUMER_ENABLED=false
