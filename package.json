{
  "name": "workshop-execution",
  "version": "0.1.0",
  "description": "Execution Service — Tech Challenge FIAP Phase 4",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "lint": "bun x tsc --noEmit",
    "check": "bun run lint && bun test"
  },
  "dependencies": {
    "hono": "^4.7.11",
    "mongodb": "6.21.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.8.3"
  }
}
